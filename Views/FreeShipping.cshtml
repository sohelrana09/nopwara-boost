@model FreeShippingModel

@*free-shipping progress (cart order summary and, compact, the flyout cart)*@
<div class="free-shipping-progress @(Model.Compact ? "mt-3 rounded-md bg-slate-50 p-3" : "mb-4 rounded-lg border border-slate-200 bg-white p-4")"
     role="status">
    <p class="flex items-center gap-2 text-sm @(Model.Reached ? "font-semibold text-emerald-700" : "text-slate-700")">
        <svg class="size-5 shrink-0 @(Model.Reached ? "text-emerald-600" : "text-primary-600")" fill="none" viewBox="0 0 24 24" stroke-width="1.6" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" /></svg>
        @if (Model.Reached)
        {
            <span>@T("Plugins.Widgets.NopwaraBoost.FreeShipping.Reached")</span>
        }
        else
        {
            <span>@Html.Raw(string.Format(T("Plugins.Widgets.NopwaraBoost.FreeShipping.Remaining").Text, $"<strong class=\"text-slate-900\">{Html.Encode(Model.Remaining)}</strong>"))</span>
        }
    </p>
    <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-200" aria-hidden="true">
        <div class="h-full rounded-full transition-[width] duration-500 @(Model.Reached ? "bg-emerald-500" : "bg-primary-600")" style="width: @(Model.Percent)%"></div>
    </div>
</div>
